{
  "name": "openflow",
  "version": "0.1.0",
  "description": "Lightweight personal AI assistant with push notifications",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "openflow": "dist/bin.js"
  },
  "scripts": {
    "dev": "tsx src/bin.ts",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/",
    "format": "oxfmt --write src/",
    "format:check": "oxfmt --check src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "oxlint src/ && oxfmt --check src/ && tsc --noEmit && vitest run",
    "start": "node dist/bin.js"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "expo-server-sdk": "^3.7.0",
    "pino": "^9.6.0",
    "ws": "^8.20.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "@types/ws": "^8.18.1",
    "oxlint": "^0.16.10",
    "tsdown": "^0.12.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "onlyBuiltDependencies": [
    "esbuild"
  ]
}
