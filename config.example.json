{
  "llm": {
    "baseUrl": "https://api.openai.com/v1",
    "apiKey": "${OPENAI_API_KEY}",
    "model": "gpt-4o",
    "maxTokens": 4096,
    "temperature": 0.7
  },
  "telegram": {
    "botToken": "${TELEGRAM_BOT_TOKEN}",
    "allowedUsers": []
  },
  "agent": {
    "systemPrompt": "",
    "maxToolRounds": 10,
    "workspace": "~/.openflow/workspace"
  },
  "memory": {
    "contextSize": 50,
    "dbPath": "~/.openflow/memory.db"
  },
  "tools": {
    "shell": {
      "enabled": true,
      "timeout": 30000
    },
    "webFetch": {
      "enabled": true
    },
    "webSearch": {
      "enabled": true
    },
    "httpRequest": {
      "enabled": false
    }
  },
  "logging": {
    "level": "info"
  }
}
